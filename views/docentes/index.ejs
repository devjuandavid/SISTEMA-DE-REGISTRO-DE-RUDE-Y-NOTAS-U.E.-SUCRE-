<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 p-6 font-sans text-slate-800">

  <div class="max-w-4xl mx-auto bg-white p-6 rounded-lg shadow-sm border border-slate-200">
    <!-- CABECERA -->
    <div class="flex justify-between items-center mb-6 pb-4 border-b border-slate-100">
      <div>
        <h1 class="text-2xl font-bold text-slate-800"><%= title %></h1>
        <p class="text-xs text-slate-500">Lista general del personal docente registrado</p>
      </div>
      <a href="/docentes/nuevo" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold px-3 py-2 rounded shadow transition">
        + Registrar Docente
      </a>
    </div>

    <!-- TABLA DE DOCENTES -->
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm border-collapse">
        <thead class="bg-slate-50 text-slate-500 text-xs uppercase font-semibold border-b border-slate-200">
          <tr>
            <th class="p-3">Nombre Completo</th>
            <th class="p-3">Email</th>
            <th class="p-3">Celular</th>
            <th class="p-3 text-center">Estado</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (docentes && docentes.length > 0) { %>
            <% docentes.forEach(docente => { %>
              <tr class="hover:bg-slate-50 transition">
                <td class="p-3 font-semibold text-slate-700">
                  <%= docente.nombre %> <%= docente.apellido %>
                </td>
                <td class="p-3 text-slate-600">
                  <%= docente.email ? docente.email : '-' %>
                </td>
                <td class="p-3 text-slate-600">
                  <%= docente.celular ? docente.celular : '-' %>
                </td>
                <td class="p-3 text-center">
                  <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-2 py-0.5 rounded-full">
                    Activo
                  </span>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="4" class="p-6 text-center text-xs text-slate-400">
                No hay docentes registrados en la base de datos.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- BOTÓN VOLVER -->
    <div class="mt-6 pt-4 border-t border-slate-100">
      <a href="/dashboard" class="text-xs text-slate-500 hover:text-slate-800 font-semibold transition">
        ← Volver al Panel Principal
      </a>
    </div>
  </div>

</body>
</html>