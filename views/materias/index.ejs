<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 p-6 font-sans text-slate-800">
  <div class="max-w-4xl mx-auto bg-white p-6 rounded-lg shadow-sm border border-slate-200">
    <div class="flex justify-between items-center mb-6 pb-4 border-b">
      <h1 class="text-2xl font-bold"><%= title %></h1>
    </div>

    <!-- Formulario rápido -->
    <form action="/materias/crear" method="POST" class="flex gap-3 mb-6">
      <input type="text" name="nombre" placeholder="Nombre de la Materia (ej: Matemáticas)" required class="border p-2 rounded w-2/3 text-sm">
      <input type="text" name="codigo" placeholder="Código (ej: MAT-101)" class="border p-2 rounded w-1/3 text-sm">
      <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded text-xs font-bold hover:bg-blue-700">Guardar</button>
    </form>

    <!-- Tabla -->
    <table class="w-full text-left text-sm border-collapse">
      <thead class="bg-slate-50 text-slate-500 text-xs uppercase font-semibold border-b">
        <tr>
          <th class="p-3">ID</th>
          <th class="p-3">Código</th>
          <th class="p-3">Nombre</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if (materias && materias.length > 0) { %>
          <% materias.forEach(materia => { %>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-mono text-slate-400"><%= materia.id %></td>
              <td class="p-3 font-bold text-slate-600"><%= materia.codigo || '-' %></td>
              <td class="p-3 font-semibold text-slate-800"><%= materia.nombre %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="3" class="p-4 text-center text-slate-400 text-xs">No hay materias registradas.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>