<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 text-slate-800 font-sans min-h-screen">

  <nav class="bg-blue-900 text-white px-6 py-4 flex justify-between items-center shadow">
    <h1 class="text-xl font-bold">U.E. ANTONIO JOSÉ DE SUCRE</h1>
    <div class="flex items-center gap-3">
      <a href="/estudiantes" class="text-sm bg-blue-800 hover:bg-blue-700 px-3 py-2 rounded transition">← Volver a Lista RUDE</a>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto p-6 space-y-6">

    <div class="bg-white p-6 rounded-xl shadow flex justify-between items-center">
      <div>
        <h2 class="text-2xl font-bold text-slate-800">Módulo de Inscripciones</h2>
        <p class="text-slate-500 text-sm">Registro rápido e inscripción de estudiantes</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Formulario de Registro Rápido -->
      <div class="bg-white p-6 rounded-xl shadow h-fit">
        <h3 class="text-lg font-bold mb-4 border-b pb-2 text-slate-800">Inscribir Nuevo Alumno</h3>
        
        <form action="/estudiantes/guardar" method="POST" class="space-y-3">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Código RUDE</label>
            <input type="text" name="codigo_rude" placeholder="Ej. 807300012026..." class="w-full border rounded p-2 text-sm outline-none focus:ring-2 focus:ring-blue-500">
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Nombres *</label>
            <input type="text" name="nombres" required placeholder="Ej. Juan Carlos" class="w-full border rounded p-2 text-sm outline-none focus:ring-2 focus:ring-blue-500">
          </div>

          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Apellido Paterno</label>
              <input type="text" name="apellido_paterno" placeholder="Pérez" class="w-full border rounded p-2 text-sm outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Apellido Materno</label>
              <input type="text" name="apellido_materno" placeholder="Mamani" class="w-full border rounded p-2 text-sm outline-none focus:ring-2 focus:ring-blue-500">
            </div>
          </div>

          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">C.I.</label>
              <input type="text" name="ci" placeholder="12345678" class="w-full border rounded p-2 text-sm outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Género</label>
              <select name="genero" class="w-full border rounded p-2 text-sm outline-none focus:ring-2 focus:ring-blue-500">
                <option value="M">Masculino</option>
                <option value="F">Femenino</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Curso Asignado *</label>
            <select name="curso_id" required class="w-full border rounded p-2 text-sm outline-none focus:ring-2 focus:ring-blue-500">
              <option value="">-- Seleccionar Curso --</option>
              <% cursos.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.grado %>° "<%= c.paralelo %>" - <%= c.nivel %> (<%= c.turno %>)</option>
              <% }) %>
            </select>
          </div>

          <div class="border-t pt-3">
            <label class="block text-xs font-semibold text-slate-600 mb-1">Nombre del Tutor</label>
            <input type="text" name="nombre_tutor" placeholder="Ej. Roberto Pérez" class="w-full border rounded p-2 text-sm outline-none focus:ring-2 focus:ring-blue-500">
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Teléfono Contacto</label>
            <input type="text" name="telefono_tutor" placeholder="Ej. 71234567" class="w-full border rounded p-2 text-sm outline-none focus:ring-2 focus:ring-blue-500">
          </div>

          <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-medium py-2 rounded-lg text-sm transition mt-2 shadow">
            Confirmar Inscripción
          </button>
        </form>
      </div>

      <!-- Tabla de Inscripciones Recientes -->
      <div class="lg:col-span-2 bg-white rounded-xl shadow overflow-hidden">
        <div class="p-4 border-b bg-slate-50 flex justify-between items-center">
          <h3 class="font-bold text-slate-700">Estudiantes Inscritos Recientemente</h3>
        </div>

        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-slate-50 border-b text-slate-600 text-xs uppercase font-semibold">
              <th class="p-3">RUDE / C.I.</th>
              <th class="p-3">Estudiante</th>
              <th class="p-3">Curso</th>
              <th class="p-3 text-center">Acción</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (inscripciones.length === 0) { %>
              <tr>
                <td colspan="4" class="text-center p-8 text-slate-400">No hay inscripciones registradas.</td>
              </tr>
            <% } else { %>
              <% inscripciones.forEach(ins => { %>
                <tr class="hover:bg-slate-50">
                  <td class="p-3 text-xs text-slate-500 font-mono">
                    <div><%= ins.rude || 'S/R' %></div>
                    <div class="text-slate-400"><%= ins.ci ? 'CI: ' + ins.ci : '' %></div>
                  </td>
                  <td class="p-3 font-bold text-slate-700"><%= ins.estudiante_nombre %></td>
                  <td class="p-3 text-slate-600"><%= ins.curso_nombre %></td>
                  <td class="p-3 text-center">
                    <a href="/estudiantes/rude/<%= ins.inscripcion_id %>" class="text-xs bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold px-2.5 py-1 rounded border border-blue-200 transition">
                      Ver RUDE
                    </a>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

    </div>
  </div>

</body>
</html>